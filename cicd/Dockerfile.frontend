# Frontend image for Substrait: build the Vite app, then serve the static bundle with
# nginx on port 80. Built from the REPO ROOT, so COPY paths are repo-relative.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ .
# Same-origin API: the ingress routes /api to the backend, so the app calls the backend
# via relative /api paths — no absolute URL is baked into the bundle.
ENV VITE_API_URL=""
RUN npm run build

FROM nginx:1.27-alpine
# Trivy scan (CVE-2026-33630 c-ares, CVE-2026-31789/2025-15467/69421/CVE-2026-28387-90/
# 45447 libcrypto3+libssl3, CVE-2025-59375/CVE-2026-25210/45186/66046/76956/76957
# libexpat, CVE-2025-64720/65018/66293/CVE-2026-22695/22801/25646 libpng, and more):
# patch every OS package to its latest available Alpine repo version rather than
# pinning each CVE's package individually — covers all of the above in one shot and
# keeps picking up future base-image CVEs on the next build.
RUN apk update && apk upgrade --no-cache
COPY --from=build /app/dist /usr/share/nginx/html
COPY cicd/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
